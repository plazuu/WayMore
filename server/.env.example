PORT=3000
GOOGLE_MAPS_API_KEY=

# --- Narration (live tour guide) ---
# Missing keys switch the matching piece to mock mode automatically:
# template lines instead of Gemini, and no audio instead of TTS.
# Set MOCK_LLM=1 / MOCK_TTS=1 to force mock mode even with keys present.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
MOCK_LLM=
MOCK_TTS=

TTS_PROVIDER=speechify            # speechify | elevenlabs

SPEECHIFY_API_KEY=
SPEECHIFY_VOICE_ID=chase
SPEECHIFY_MODEL=simba-3.2
SPEECHIFY_RATE=+10%               # SSML prosody rate; +10% is about 1.10x speed
SPEECHIFY_EMOTION=energetic       # energetic, cheerful, warm, bright, calm, relaxed, assertive, direct, ... or empty

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_flash_v2_5

# Relative to the server/ directory. Changing voice settings regenerates audio.
AUDIO_CACHE_DIR=data/audio_cache
