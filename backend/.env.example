PORT=3001

# --- LLM (OpenAI writes narration lines and answers chat) ---
# Missing keys switch the matching piece to mock mode automatically:
# template lines instead of the LLM, and no audio instead of TTS.
# Set MOCK_LLM=1 / MOCK_TTS=1 to force mock mode even with keys present.
OPENAI_API_KEY=
# Empty model names use the defaults in src/config.ts (gpt-4.1-nano, gpt-4o-mini).
OPENAI_NARRATION_MODEL=
OPENAI_CHAT_MODEL=
MOCK_LLM=
MOCK_TTS=

TTS_PROVIDER=speechify            # speechify | elevenlabs
TTS_CONCURRENCY=1                 # simultaneous TTS requests; Speechify's base plan allows 1

SPEECHIFY_API_KEY=
SPEECHIFY_VOICE_ID=chase
SPEECHIFY_MODEL=simba-3.2
SPEECHIFY_RATE=+10%               # SSML prosody rate; +10% is about 1.10x speed
SPEECHIFY_EMOTION=energetic       # energetic, cheerful, warm, bright, calm, relaxed, assertive, direct, ... or empty

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_flash_v2_5

# Relative to the backend/ directory. Changing voice settings regenerates audio.
AUDIO_CACHE_DIR=data/audio_cache

# --- Live guide ---
# The app's public URL: server/'s tunnel (port 3000), NOT this backend's, since
# the app reaches /audio through server/'s proxy. When set, audioUrl in
# /tour/tick responses is absolute. Restart after changing.
PUBLIC_BASE_URL=
