# Optional. Base URL of the Express server in ../server. Leave empty to use the
# machine Metro is running on (port 3000), which works for emulators and for
# phones on the same Wi-Fi. Can also be changed in the app's Developer settings.
EXPO_PUBLIC_API_URL=

# Optional. Maps SDK for Android key, only used by development builds (not Expo Go).
# See app.config.js.
GOOGLE_MAPS_ANDROID_API_KEY=
